# =============================================================
# MART_PROG — Unity .gitignore
# Keeps Unity-generated, machine-local, and build output out of Git.
# Assets/ and ProjectSettings/ ARE tracked — never ignore those.
# =============================================================

# --- Unity generated folders (rebuilt automatically) ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/

# --- Asset meta data should only be ignored for ignored assets ---
# (handled automatically because the asset itself is ignored)

# --- Autogenerated VS / Rider / IDE project files ---
/.vs/
/.vscode/
/.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# --- Unity3D generated meta files for build/exports ---
*.pidb.meta
*.pdb.meta
*.mdb.meta

# --- Gradle / Android build intermediates ---
*.apk
*.aab
*.unitypackage
*.app

# --- Crash / profiling reports ---
sysinfo.txt
crashlytics-build.properties

# --- OS junk ---
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# --- Unity Version Control (Plastic) local cache, if ever enabled ---
.plastic/

# Native/CMake build cache (IL2CPP Android builds)
.utmp/
